APP_HOST=127.0.0.1
APP_PORT=8080
APP_DATA_DIR=/var/lib/bind9-web-manager
DATABASE_URL=sqlite:////var/lib/bind9-web-manager/database.db
BIND_CONFIG=/etc/bind/named.conf
BIND_LOCAL_CONFIG=/etc/bind/named.conf.local
BIND_MANAGED_CONFIG=/etc/bind/named.conf.chrislab
BIND_ZONE_DIR=/etc/bind/zones
BACKUP_DIR=/var/lib/bind9-web-manager/backups
STAGING_DIR=/var/lib/bind9-web-manager/staging
BIND_HELPER=/usr/bin/sudo /usr/local/libexec/bind9-web-manager-helper
DHCP_HELPER=/usr/bin/sudo /usr/local/libexec/chrislab-dhcp-helper
SESSION_SECURE=true
SESSION_SAMESITE=lax
SESSION_MAX_AGE=28800
AUTO_BACKUP=true
TRUSTED_HOSTS=*
LOG_LEVEL=INFO
